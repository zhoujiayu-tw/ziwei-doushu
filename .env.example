# 本機開發：複製為 .env.local 後填入實際值
# 部署到 Cloudflare：ANTHROPIC_API_KEY 用 `npx wrangler secret put ANTHROPIC_API_KEY` 設定

# ─── AI 解讀（/api/interpret、/api/heming）───
# 只想排盤、看命盤的話不用填
ANTHROPIC_API_KEY=your-anthropic-api-key
# 選填：預設 claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# ─── 站點 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
