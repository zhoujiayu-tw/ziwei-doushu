{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "zhoujiayu-ziwei",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// 自我引用的 service binding，service 名稱必須和上面的 name 一致
			// 見 https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "zhoujiayu-ziwei"
		}
	],
	// 自訂網域：zhoujiayu.app 必須在同一個 Cloudflare 帳號，部署時會自動建立 DNS 紀錄與憑證
	"routes": [{ "pattern": "bz.zhoujiayu.app", "custom_domain": true }],
	// AI 介面的流量限制（見 lib/ai/rate-limit.ts）；period 只能是 10 或 60 秒
	"ratelimits": [
		{ "name": "AI_RATE_LIMITER", "namespace_id": "4101", "simple": { "limit": 6, "period": 60 } },
		{ "name": "AI_GLOBAL_LIMITER", "namespace_id": "4102", "simple": { "limit": 60, "period": 60 } }
	],
	"observability": { "enabled": true }
	// ANTHROPIC_API_KEY 用 `npx wrangler secret put ANTHROPIC_API_KEY` 設定，不要寫在這裡
}
